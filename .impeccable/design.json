  "narrative": {
    "northStar": "The Quiet Signboard",
    "overview": "The page behaves like good signage: the one number that matters is the largest thing on it, status is a shape plus a word, and everything else stays out of the way until something is wrong. Neutral and low-glare in light and dark, in the system sans with tabular numerals. Colour is never decoration.",
    "keyCharacteristics": [
      "One framed surface (the status band); everything else is plain sections divided by hairlines.",
      "Status is always shape plus text plus colour.",
      "Neutral controls; no brand accent.",
      "Chart reference lines carry the meaning.",
      "Stale data is visibly dimmed, with the last-sample time shown."
    ],
    "rules": [
      {
        "name": "The Meaning-Only Colour Rule",
        "body": "Green, amber and red appear only where they state a status or a limit.",
        "section": "colors"
      },
      {
        "name": "The Never-Colour-Alone Rule",
        "body": "Every status colour is paired with a text label and, for frequency status, a distinct shape.",
        "section": "colors"
      },
      {
        "name": "The Quiet-Normal Rule",
        "body": "Normal is neutral surface with ink text; only the small status label and icon carry green.",
        "section": "colors"
      },
      {
        "name": "The Tabular Rule",
        "body": "Every value that updates uses tabular numerals.",
        "section": "typography"
      },
      {
        "name": "The Flat-By-Default Rule",
        "body": "No box shadows. A surface is either a hairline-bordered panel or part of the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep status as shape plus text plus colour.",
      "Do use the theme tokens rather than raw palette colours.",
      "Do use tabular numerals for every changing value.",
      "Do make stale or disconnected data look stale.",
      "Do keep motion to short state transitions and respect prefers-reduced-motion."
    ],
    "donts": [
      "Don't add an accent colour, gradients, glass effects, shadows or decorative illustrations.",
      "Don't convey status with colour alone.",
      "Don't animate on every sample or flash on change.",
      "Don't turn the page into a grid of identical cards."
    ]
  }
